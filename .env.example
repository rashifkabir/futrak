# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── CV / detection ─────────────────────────────────────────
# Roboflow account key. Only needed to re-train or re-export the ball +
# goalpost detector. Normal inference runs the local ONNX weights offline
# and needs no key. Used by test_custom_model.py.
ROBOFLOW_API_KEY=your-roboflow-api-key

# ─── Optional LLM coaching feedback ─────────────────────────
# Anthropic key for the natural-language feedback layer
# (backend/cv_engine/ai_feedback.py, coaching_llm.py). Optional: the CV
# scoring pipeline runs fully without it and coaching_llm.py falls back to
# templated feedback when this is unset.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Supabase (King of the Pitch backend) ───────────────────
# Only needed to apply migrations, run the pitch seed importer, or deploy
# the notification edge function. No project is provisioned yet.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — bypasses row-level security. Server/CLI only, never
# ship this to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Mobile dev ─────────────────────────────────────────────
# LAN address of your dev machine running the FastAPI backend, read by
# mobile/src/lib/api.ts. Physical devices need the real IP; the Android
# emulator can use http://10.0.2.2:8000. Put this in mobile/.env
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
